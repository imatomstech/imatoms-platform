{
  "name": "imatoms-platform-api",
  "version": "3.0.0",
  "description": "iMATOMs Platform Backend API — TKO Technology",
  "main": "server.js",
  "scripts": {
    "start":    "node server.js",
    "dev":      "nodemon server.js",
    "db:init":  "psql $DATABASE_URL -f schema.sql",
    "db:reset": "psql $DATABASE_URL -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run db:init"
  },
  "dependencies": {
    "bcrypt":              "^5.1.1",
    "cors":                "^2.8.5",
    "dotenv":              "^16.4.5",
    "express":             "^4.19.2",
    "express-rate-limit":  "^7.3.1",
    "helmet":              "^7.1.0",
    "jsonwebtoken":        "^9.0.2",
    "pg":                  "^8.12.0",
    "uuid":                "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
